#!/usr/bin/env bash
# detection-lab-lite control CLI. Docker only, no VM.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

# --- config ---------------------------------------------------------------
[ -f .env ] || cp .env.example .env
set -a; . ./.env; set +a
: "${WAZUH_DOCKER_REF:=v4.14.7}"
: "${COMPOSE_PARALLEL_LIMIT:=1}"
export COMPOSE_PARALLEL_LIMIT
# Absolute repo root for compose var-substitution (works regardless of which
# directory compose treats as the project directory).
export DLL_ROOT="$ROOT"
# Unbuffered so ./lab test's per-scenario PASS/FAIL prints as it happens
# instead of sitting in a pipe buffer until the process exits (matters a lot
# when this runs under `2>&1 | tee`/CI log capture, not a real tty).
export PYTHONUNBUFFERED=1
WAZUH_DIR=".wazuh-docker"
WAZUH_SINGLE="$WAZUH_DIR/single-node/docker-compose.yml"

# Compose file stack: upstream Wazuh single-node + our overlays.
COMPOSE_ARGS=(-p detection-lab
  -f "$WAZUH_SINGLE"
  -f compose/compose.overlay.yml
  -f compose/compose.detections.yml
  -f compose/compose.honeypots.yml
  -f compose/compose.targets.yml)

log() { printf '\033[1;36m[lab]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[lab] %s\033[0m\n' "$*" >&2; exit 1; }

# --- commands ------------------------------------------------------------
cmd_bootstrap() {
  if [ ! -d "$WAZUH_DIR/.git" ]; then
    log "cloning wazuh-docker $WAZUH_DOCKER_REF (one download)"
    git clone --depth 1 --branch "$WAZUH_DOCKER_REF" \
      https://github.com/wazuh/wazuh-docker.git "$WAZUH_DIR"
  else
    log "wazuh-docker already present ($(git -C "$WAZUH_DIR" describe --tags 2>/dev/null || echo unknown))"
  fi
  if [ ! -f "$WAZUH_DIR/single-node/config/wazuh_indexer_ssl_certs/root-ca.pem" ]; then
    log "generating indexer certs (one-time)"
    docker compose -f "$WAZUH_DIR/single-node/generate-indexer-certs.yml" run --rm generator
  else
    log "indexer certs already generated"
  fi
  log "bootstrap done — run './lab up'"
}

_require_bootstrap() { [ -f "$WAZUH_SINGLE" ] || die "run './lab bootstrap' first"; }

cmd_pull() {
  _require_bootstrap
  log "pulling images sequentially (COMPOSE_PARALLEL_LIMIT=$COMPOSE_PARALLEL_LIMIT)"
  # explicit ordered loop so downloads never overlap
  for svc in $(docker compose "${COMPOSE_ARGS[@]}" config --services); do
    log "pull: $svc"
    docker compose "${COMPOSE_ARGS[@]}" pull --policy missing "$svc" || true
  done
}

cmd_up() {
  _require_bootstrap
  cmd_pull
  log "starting stack"
  docker compose "${COMPOSE_ARGS[@]}" up -d --build
  log "Wazuh dashboard: https://localhost  (admin / SecretPassword)"
  log "wait ~3-5 min, then './lab status'"
}

cmd_down() { _require_bootstrap; docker compose "${COMPOSE_ARGS[@]}" down "${@:-}"; }
cmd_status() { _require_bootstrap; docker compose "${COMPOSE_ARGS[@]}" ps; }
cmd_logs() { _require_bootstrap; docker compose "${COMPOSE_ARGS[@]}" logs -f "$@"; }

cmd_attack()  { exec python3 harness/runner.py "$@"; }
cmd_verify()  { exec python3 harness/verify.py "$@"; }
cmd_report()  { exec python3 harness/report.py "$@"; }
cmd_sigma()   { exec python3 harness/sigma_build.py "$@"; }

_idx() { docker compose "${COMPOSE_ARGS[@]}" exec -T wazuh.indexer \
  curl -sk -u "admin:${INDEXER_PASSWORD:-SecretPassword}" \
  -H 'Content-Type: application/json' "https://localhost:9200/$1" "${@:2}"; }

cmd_wait_ready() {
  log "waiting for the target-linux agent to become active (up to 180s)"
  for _ in $(seq 1 36); do
    docker compose "${COMPOSE_ARGS[@]}" exec -T wazuh.manager \
      /var/ossec/bin/agent_control -l 2>/dev/null | grep -qiE 'target-linux.*Active' && break
    sleep 5
  done

  # canary: keep rewriting a watched file until its FIM alert reaches the indexer,
  # proving the whole agent -> manager -> filebeat -> indexer path is hot. Rewrite
  # every iteration — an early write can be absorbed into the FIM baseline before
  # realtime monitoring is ready, and only a *later* change then alerts.
  log "warming up the detection pipeline (FIM canary, up to 240s)"
  for _ in $(seq 1 48); do
    docker compose "${COMPOSE_ARGS[@]}" exec -T target-linux \
      sh -c 'mkdir -p /etc/cron.d && echo "# dll canary $(date +%s%N)" > /etc/cron.d/dll-canary' 2>/dev/null
    if _idx 'wazuh-alerts-*/_count' -d '{"query":{"wildcard":{"syscheck.path":"*dll-canary*"}}}' \
         2>/dev/null | grep -qE '"count":[1-9]'; then
      log "pipeline hot"; return 0
    fi
    sleep 5
  done
  log "canary alert never arrived — continuing anyway (FIM checks may be flaky)"
}

cmd_test() {
  # replay every scenario, then assert every expected alert (local end-to-end check)
  local s tid
  cmd_wait_ready
  for s in attacks/scenarios/*.yml; do
    tid=$(basename "$s" .yml); tid=${tid%%_*}
    python3 harness/runner.py "$tid" || true
  done
  python3 harness/verify.py --all
}

usage() {
  cat <<'EOF'
detection-lab-lite

  ./lab bootstrap        clone wazuh-docker + generate certs (run once)
  ./lab up               pull (sequential) + start the whole stack
  ./lab down [-v]        stop the stack (-v also drops volumes)
  ./lab status           container health
  ./lab logs [svc...]    follow logs
  ./lab pull             pull images, one at a time
  ./lab attack <TID>     run an attack scenario against target-linux
  ./lab verify <TID>     assert the expected alert fired (--all for every scenario)
  ./lab test             replay every scenario then verify --all (local end-to-end)
  ./lab sigma [--check]  convert detections/*.yml -> Wazuh rules
  ./lab report           regenerate ATT&CK coverage matrix + navigator layer
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    bootstrap) cmd_bootstrap "$@" ;;
    up)        cmd_up "$@" ;;
    down)      cmd_down "$@" ;;
    status)    cmd_status "$@" ;;
    logs)      cmd_logs "$@" ;;
    pull)      cmd_pull "$@" ;;
    attack)    cmd_attack "$@" ;;
    verify)    cmd_verify "$@" ;;
    report)    cmd_report "$@" ;;
    sigma)     cmd_sigma "$@" ;;
    test)      cmd_test "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}
main "$@"
