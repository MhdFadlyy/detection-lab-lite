# Copy to .env and adjust. `./lab` loads .env automatically.

# --- Wazuh upstream (cloned by `./lab bootstrap`, never vendored) ---
WAZUH_DOCKER_REF=v4.14.7

# --- Resource tuning (fits a 16 GB laptop and a GitHub-hosted runner) ---
# Indexer JVM heap. 1g is enough for a lab; bump to 2g if you have RAM to spare.
INDEXER_JAVA_OPTS="-Xms1g -Xmx1g"

# --- Wazuh dashboard / API credentials (lab only — do not reuse anywhere) ---
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# --- Compose: pull images one at a time (project rule) ---
COMPOSE_PARALLEL_LIMIT=1
