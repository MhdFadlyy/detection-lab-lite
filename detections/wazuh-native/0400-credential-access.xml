<!-- Credential Access (T1003, T1552) -->
<group name="detection-lab-lite,linux,credential_access,">

  <rule id="100410" level="12">
    <if_sid>100200</if_sid>
    <field name="audit.command">cat|cp|head|tail|less|more|xxd|base64</field>
    <match>/etc/shadow</match>
    <description>/etc/shadow read or copied — credential dumping (T1003.008)</description>
    <mitre><id>T1003.008</id></mitre>
  </rule>

  <rule id="100411" level="8">
    <if_sid>100200</if_sid>
    <field name="audit.command">grep|egrep|rg| grep</field>
    <match>password|passwd|secret|api_key|apikey|token</match>
    <description>Filesystem grep for secrets — credentials in files (T1552.001)</description>
    <mitre><id>T1552.001</id></mitre>
  </rule>

</group>
