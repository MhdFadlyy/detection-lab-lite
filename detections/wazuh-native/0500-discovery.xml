<!-- Discovery (T1033, T1087, T1082) -->
<group name="detection-lab-lite,linux,discovery,">

  <rule id="100510" level="5">
    <if_sid>100203</if_sid>
    <description>Account/context discovery: whoami or id (T1033)</description>
    <mitre><id>T1033</id></mitre>
  </rule>

  <rule id="100511" level="5">
    <if_sid>100200</if_sid>
    <field name="audit.command">getent|cat</field>
    <match>/etc/passwd|/etc/group</match>
    <description>Local account enumeration via passwd/group (T1087.001)</description>
    <mitre><id>T1087.001</id></mitre>
  </rule>

  <rule id="100512" level="3">
    <if_sid>100200</if_sid>
    <field name="audit.command">uname|hostnamectl|lsb_release|lscpu</field>
    <description>System information discovery (T1082)</description>
    <mitre><id>T1082</id></mitre>
  </rule>

  <!-- correlation: several discovery commands from one session in a short window -->
  <rule id="100519" level="10" frequency="4" timeframe="120">
    <if_matched_sid>100512</if_matched_sid>
    <same_source_ip />
    <description>Multiple discovery commands in 2 min — likely hands-on-keyboard recon (T1082/T1087/T1033)</description>
    <mitre><id>T1082</id></mitre>
  </rule>

</group>
