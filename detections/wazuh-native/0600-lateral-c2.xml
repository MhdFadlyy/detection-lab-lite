<!-- Lateral Movement (T1021) + Command and Control / Ingress (T1071, T1105) -->
<group name="detection-lab-lite,linux,">

  <rule id="100610" level="6">
    <if_sid>100200</if_sid>
    <field name="audit.command">ssh|sshpass</field>
    <description>Outbound SSH client execution — possible lateral movement (T1021.004)</description>
    <mitre><id>T1021.004</id></mitre>
  </rule>

  <rule id="100710" level="8">
    <if_sid>100200</if_sid>
    <field name="audit.command">curl|wget</field>
    <match>http://|https://|ftp://</match>
    <description>File download via curl/wget — ingress tool transfer (T1105)</description>
    <mitre><id>T1105</id><id>T1071.001</id></mitre>
  </rule>

  <rule id="100711" level="10">
    <if_sid>100710</if_sid>
    <match> -o |--output| -O |>/tmp/|>/dev/shm/</match>
    <description>Remote file downloaded to a temp/exec path — ingress tool transfer (T1105)</description>
    <mitre><id>T1105</id></mitre>
  </rule>

</group>
