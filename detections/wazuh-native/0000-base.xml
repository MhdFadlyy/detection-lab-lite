<!--
  detection-lab-lite base rules. All hand rules chain from these so a single
  <if_sid> keeps conversions and hand rules scoped (see README "Sigma caveat").
  ID ranges: 1002xx execution, 1003xx persistence, 1004xx credential-access,
             1005xx discovery, 1006xx lateral-movement, 1007xx c2/ingress.
-->
<group name="detection-lab-lite,linux,">

  <rule id="100200" level="0">
    <if_group>audit</if_group>
    <field name="audit.key">dll_exec</field>
    <description>dll: audited process execution (base)</description>
  </rule>

  <rule id="100201" level="0">
    <if_group>audit</if_group>
    <field name="audit.key">dll_persistence</field>
    <description>dll: write to a persistence surface (base)</description>
  </rule>

  <rule id="100202" level="0">
    <if_group>audit</if_group>
    <field name="audit.key">dll_cred_access</field>
    <description>dll: access to a credential file (base)</description>
  </rule>

  <rule id="100203" level="0">
    <if_group>audit</if_group>
    <field name="audit.key">dll_discovery</field>
    <description>dll: discovery binary executed (base)</description>
  </rule>

</group>
